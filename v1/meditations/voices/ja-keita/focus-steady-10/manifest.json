      "file": "c012.ogg",
      "durationSec": 4.032
    },
    {
      "index": 13,
      "text": "鼻孔での呼吸をポイントに選びましょう。",
      "file": "c013.ogg",
      "durationSec": 5.592
    },
    {
      "index": 14,
      "text": "空気感をそのままに。",
