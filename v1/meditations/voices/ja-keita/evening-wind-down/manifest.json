{
  "id": "evening-wind-down",
  "voiceId": "ja-keita",
  "edgeVoice": "ja-JP-KeitaNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 150,
  "chunks": [
    {
      "index": 0,
      "text": "この練習は一日の終わりのためのものです。",
      "file": "c000.ogg",
      "durationSec": 6.624
    },
    {
      "index": 1,
      "text": "可能であれば照明を暗くしてください。",
      "file": "c001.ogg",
      "durationSec": 5.808
    },
    {
      "index": 2,
      "text": "サポートを受けながら横になるか寄りかかります。",
      "file": "c002.ogg",
      "durationSec": 6.024
    },
    {
      "index": 3,
      "text": "たとえ頭の中でタスクがリストアップされていても、その日は終わりにしましょう。",
      "file": "c003.ogg",
      "durationSec": 9.936
    },
    {
      "index": 4,
      "text": "とりあえずは設定しておいても大丈夫です。",
      "file": "c004.ogg",
      "durationSec": 6.048
    },
    {
      "index": 5,
      "text": "4つ数えながら静かに息を吸います。",
      "file": "c005.ogg",
      "durationSec": 5.736
    },
    {
      "index": 6,
      "text": "6つ数えながら息を吐きます。",
      "file": "c006.ogg",
      "durationSec": 4.92
    },
    {
      "index": 7,
      "text": "また。 4 インチ、6 アウト。",
      "file": "c007.ogg",
      "durationSec": 6.6
    },
    {
      "index": 8,
      "text": "息を長く吐くと、体は安全に休むことができます。",
      "file": "c008.ogg",
      "durationSec": 7.968
    },
    {
      "index": 9,
      "text": "顔に残っている緊張をスキャンします。",
      "file": "c009.ogg",
      "durationSec": 5.496
    },
    {
      "index": 10,
      "text": "眉を柔らかくします。顎を柔らかくします。",
      "file": "c010.ogg",
      "durationSec": 7.92
    },
    {
      "index": 11,
      "text": "肩を耳から遠ざけます。",
      "file": "c011.ogg",
      "durationSec": 4.392
    },
    {
      "index": 12,
      "text": "そよ風が吹いた後の塵のように一日が静まるところを想像してみてください。",
      "file": "c012.ogg",
      "durationSec": 9.792
    },
    {
      "index": 13,
      "text": "何が起こった、起こった。",
      "file": "c013.ogg",
      "durationSec": 4.488
    },
    {
      "index": 14,
      "text": "残ったものは朝まで待つことができます。",
      "file": "c014.ogg",
      "durationSec": 6.144
    },
    {
      "index": 15,
      "text": "マットレスや床があなたを支えているのを感じてください。",
      "file": "c015.ogg",
      "durationSec": 7.008
    },
    {
      "index": 16,
      "text": "呼吸が静かになります。体が重くなる。",
      "file": "c016.ogg",
      "durationSec": 7.512
    },
    {
      "index": 17,
      "text": "眠りが来たら、そのままにしましょう。",
      "file": "c017.ogg",
      "durationSec": 5.712
    },
    {
      "index": 18,
      "text": "そうでない場合は、とにかくこの柔らかさの中で休んでください。",
      "file": "c018.ogg",
      "durationSec": 8.616
    },
    {
      "index": 19,
      "text": "さらに3回ゆっくりと呼吸します。",
      "file": "c019.ogg",
      "durationSec": 5.28
    },
    {
      "index": 20,
      "text": "で。外。",
      "file": "c020.ogg",
      "durationSec": 3.888
    },
    {
      "index": 21,
      "text": "で。外。",
      "file": "c021.ogg",
      "durationSec": 3.888
    },
    {
      "index": 22,
      "text": "で。外。",
      "file": "c022.ogg",
      "durationSec": 3.888
    },
    {
      "index": 23,
      "text": "今日はおやすみなさい。夜まで平和に。",
      "file": "c023.ogg",
      "durationSec": 6.696
    }
  ]
}
