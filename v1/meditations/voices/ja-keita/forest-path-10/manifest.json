{
  "id": "forest-path-10",
  "voiceId": "ja-keita",
  "edgeVoice": "ja-JP-KeitaNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 718,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "自分に何も求めない姿勢を見つけてください。",
      "file": "c001.ogg",
      "durationSec": 6.552
    },
    {
      "index": 2,
      "text": "必要なサポートを受けながら、座ったり、横になったりしてください。",
      "file": "c002.ogg",
      "durationSec": 9.192
    },
    {
      "index": 3,
      "text": "手を開いて、または柔らかく置いてください。",
      "file": "c003.ogg",
      "durationSec": 6.504
    },
    {
      "index": 4,
      "text": "目を閉じるか、優しい視線を保ちましょう。",
      "file": "c004.ogg",
      "durationSec": 6.552
    },
    {
      "index": 5,
      "text": "体と地面が接する場所を感じてください。",
      "file": "c005.ogg",
      "durationSec": 6.072
    },
    {
      "index": 6,
      "text": "かかと、座骨、後頭部、背骨の長さなどです。",
      "file": "c006.ogg",
      "durationSec": 8.928
    },
    {
      "index": 7,
      "text": "今のところ我慢できるものは何もありません。",
      "file": "c007.ogg",
      "durationSec": 6.336
    },
    {
      "index": 8,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c008.ogg",
      "durationSec": 4.872
    },
    {
      "index": 9,
      "text": "入ってくる空気の冷たさを感じてください。",
      "file": "c009.ogg",
      "durationSec": 6.048
    },
    {
      "index": 10,
      "text": "そして、少し長めに息を吐きます。",
      "file": "c010.ogg",
      "durationSec": 6.072
    },
    {
      "index": 11,
      "text": "出る呼気の温かさを感じてください。",
      "file": "c011.ogg",
      "durationSec": 5.304
    },
    {
      "index": 12,
      "text": "また。ソフトに吸い込みます。",
      "file": "c012.ogg",
      "durationSec": 5.832
    },
    {
      "index": 13,
      "text": "ゆっくりと息を吐きます。",
      "file": "c013.ogg",
      "durationSec": 4.104
    },
    {
      "index": 14,
      "text": "肩を少し下げてみましょう。",
      "file": "c014.ogg",
      "durationSec": 4.32
    },
    {
      "index": 15,
      "text": "顎を緩めましょう。",
      "file": "c015.ogg",
      "durationSec": 3.552
    },
    {
      "index": 16,
      "text": "お腹を柔らかくしましょう。",
      "file": "c016.ogg",
      "durationSec": 4.272
    },
    {
      "index": 17,
      "text": "そのままの状態で、静かな呼吸を 3 回続けてください。",
      "file": "c017.ogg",
      "durationSec": 8.52
    },
    {
      "index": 18,
      "text": "吸い込む。到着。",
      "file": "c018.ogg",
      "durationSec": 5.016
    },
    {
      "index": 19,
      "text": "息を吐きます。解決する。",
      "file": "c019.ogg",
      "durationSec": 6.0
    },
    {
      "index": 20,
      "text": "心がさまよったら、優しく気づいて、この呼吸に戻ってきてください。",
      "file": "c020.ogg",
      "durationSec": 9.624
    },
    {
      "index": 21,
      "text": "さて、古い森へゆっくりと歩き始めます。",
      "file": "c021.ogg",
      "durationSec": 6.648
    },
    {
      "index": 22,
      "text": "針葉樹と落ち葉で柔らかい道です。",
      "file": "c022.ogg",
      "durationSec": 5.64
    },
    {
      "index": 23,
      "text": "足を踏み出すたびに静かな音が鳴り、そして再び静寂が戻ります。",
      "file": "c023.ogg",
      "durationSec": 9.576
    },
    {
      "index": 24,
      "text": "暖かいリボンの高い枝を日光が通ります。",
      "file": "c024.ogg",
      "durationSec": 6.528
    },
    {
      "index": 25,
      "text": "前腕に太陽の斑点が当たるのを感じてください。突然の穏やかな熱です。",
      "file": "c025.ogg",
      "durationSec": 11.064
    },
    {
      "index": 26,
      "text": "次に、再び日陰になり、涼しく緑になります。",
      "file": "c026.ogg",
      "durationSec": 8.208
    },
    {
      "index": 27,
      "text": "風が吹くと天蓋が動きます。新鮮な空気が顔に届きます。",
      "file": "c027.ogg",
      "durationSec": 9.936
    },
    {
      "index": 28,
      "text": "樹脂の香り、湿った土の香り、そして苔の清らかな甘さ。",
      "file": "c028.ogg",
      "durationSec": 9.552
    },
    {
      "index": 29,
      "text": "一時停止。粗い樹皮の上に手のひらを置きます。",
      "file": "c029.ogg",
      "durationSec": 8.136
    },
    {
      "index": 30,
      "text": "木の静けさがあなたの手に伝わるのを感じてください。",
      "file": "c030.ogg",
      "durationSec": 6.768
    },
    {
      "index": 31,
      "text": "さらに深く進みます。外の世界の音が消えていきます。",
      "file": "c031.ogg",
      "durationSec": 9.024
    },
    {
      "index": 32,
      "text": "どこかで小川が小さな明るい音節で話します。",
      "file": "c032.ogg",
      "durationSec": 6.696
    },
    {
      "index": 33,
      "text": "石の間に水が現れるまで続けます。",
      "file": "c033.ogg",
      "durationSec": 5.976
    },
    {
      "index": 34,
      "text": "ひざまずいてください。手を浸します。クールな透明感。",
      "file": "c034.ogg",
      "durationSec": 9.912
    },
    {
      "index": 35,
      "text": "手首に少し吹きかけます。爽やかさが肌を目覚めさせます。",
      "file": "c035.ogg",
      "durationSec": 9.264
    },
    {
      "index": 36,
      "text": "細い太陽の柱で温められた平らな岩の上に座ります。",
      "file": "c036.ogg",
      "durationSec": 8.352
    },
    {
      "index": 37,
      "text": "座骨と太ももの裏に温かさを感じてください。",
      "file": "c037.ogg",
      "durationSec": 6.624
    },
    {
      "index": 38,
      "text": "すねに小川の涼しい息吹を感じてください。",
      "file": "c038.ogg",
      "durationSec": 6.096
    },
    {
      "index": 39,
      "text": "鳥は一度鳴くと、再び静かな空間から去ります。",
      "file": "c039.ogg",
      "durationSec": 7.752
    },
    {
      "index": 40,
      "text": "森の清々しさを吸い込みましょう。",
      "file": "c040.ogg",
      "durationSec": 5.04
    },
    {
      "index": 41,
      "text": "周囲の患者の体幹に息を吐きます。",
      "file": "c041.ogg",
      "durationSec": 5.568
    },
    {
      "index": 42,
      "text": "頼まれてもいないのに肩が下がっていることに注目してください。",
      "file": "c042.ogg",
      "durationSec": 7.896
    },
    {
      "index": 43,
      "text": "他に居場所がないとき、顎がどれほど柔らかくなるか。",
      "file": "c043.ogg",
      "durationSec": 7.632
    },
    {
      "index": 44,
      "text": "準備ができたら立ち、少し遠くまで歩きます。",
      "file": "c044.ogg",
      "durationSec": 7.152
    },
    {
      "index": 45,
      "text": "シダが涼しい緑色の指先でふくらはぎを撫でてくれます。",
      "file": "c045.ogg",
      "durationSec": 7.824
    },
    {
      "index": 46,
      "text": "息を止めたような空間が開ける。",
      "file": "c046.ogg",
      "durationSec": 5.184
    },
    {
      "index": 47,
      "text": "深い苔の上に仰向けになります。",
      "file": "c047.ogg",
      "durationSec": 5.088
    },
    {
      "index": 48,
      "text": "地球はあなたの体重を完全に受け止めます。",
      "file": "c048.ogg",
      "durationSec": 6.312
    },
    {
      "index": 49,
      "text": "顔に当たる木漏れ日の暖かさ。",
      "file": "c049.ogg",
      "durationSec": 4.896
    },
    {
      "index": 50,
      "text": "背筋に沿った苔の涼しさ。",
      "file": "c050.ogg",
      "durationSec": 4.608
    },
    {
      "index": 51,
      "text": "風が来て、去り、またやって来ます。",
      "file": "c051.ogg",
      "durationSec": 6.312
    },
    {
      "index": 52,
      "text": "生きた場所に抱かれている感覚を持ち続ける。",
      "file": "c052.ogg",
      "durationSec": 6.264
    },
    {
      "index": 53,
      "text": "安全。静かな。努力なしで所属する。",
      "file": "c053.ogg",
      "durationSec": 8.88
    },
    {
      "index": 54,
      "text": "ここでゆっくりとした呼吸を 5 回数えて、それぞれの呼吸を柔らかくします。",
      "file": "c054.ogg",
      "durationSec": 9.936
    },
    {
      "index": 55,
      "text": "香りにもう一度注目してください - 緑、湿った、正直な香り。",
      "file": "c055.ogg",
      "durationSec": 10.68
    },
    {
      "index": 56,
      "text": "再び音に注目してください。ほとんど音が聞こえず、それで十分です。",
      "file": "c056.ogg",
      "durationSec": 11.28
    },
    {
      "index": 57,
      "text": "何か考えが浮かんだら、それを川の上の木の葉のように漂わせてください。",
      "file": "c057.ogg",
      "durationSec": 9.912
    },
    {
      "index": 58,
      "text": "太陽が当たる場所ならどこでも、暖かな肌に戻ります。",
      "file": "c058.ogg",
      "durationSec": 8.112
    },
    {
      "index": 59,
      "text": "暖かいリボンの間の日陰で涼しさに戻りましょう。",
      "file": "c059.ogg",
      "durationSec": 7.08
    },
    {
      "index": 60,
      "text": "あなたは内側に向かって十分に歩いてきました。",
      "file": "c060.ogg",
      "durationSec": 6.768
    },
    {
      "index": 61,
      "text": "3回のゆっくりとした呼吸でこれを体内に封じ込めましょう。",
      "file": "c061.ogg",
      "durationSec": 7.872
    },
    {
      "index": 62,
      "text": "出発する前に、もう一度小川に立ってください。",
      "file": "c062.ogg",
      "durationSec": 7.224
    },
    {
      "index": 63,
      "text": "石の周りにきれいな水が編まれている様子を観察してください。",
      "file": "c063.ogg",
      "durationSec": 7.944
    },
    {
      "index": 64,
      "text": "冷たい空気は移動する表面から上昇します。",
      "file": "c064.ogg",
      "durationSec": 6.864
    },
    {
      "index": 65,
      "text": "暖かい光が前腕の部分をまだ見つけます。",
      "file": "c065.ogg",
      "durationSec": 6.744
    },
    {
      "index": 66,
      "text": "必要に応じて、水をカップに入れて眉を濡らしてください。想像力で、クールで親切です。",
      "file": "c066.ogg",
      "durationSec": 14.04
    },
    {
      "index": 67,
      "text": "森は拍手をしない。それはただ続くだけです。",
      "file": "c067.ogg",
      "durationSec": 7.896
    },
    {
      "index": 68,
      "text": "その続きが先生です。",
      "file": "c068.ogg",
      "durationSec": 4.344
    },
    {
      "index": 69,
      "text": "心の中で静かに数歩外に向かって道を歩きます。",
      "file": "c069.ogg",
      "durationSec": 7.68
    },
    {
      "index": 70,
      "text": "足の下に針。柔らかい音。ソフトリターン。",
      "file": "c070.ogg",
      "durationSec": 9.336
    },
    {
      "index": 71,
      "text": "それでも、開拓地の平和は蓄えた太陽のように胸の中に残ります。",
      "file": "c071.ogg",
      "durationSec": 9.936
    },
    {
      "index": 72,
      "text": "そこを感じてください - 胸骨の後ろの暖かさ。",
      "file": "c072.ogg",
      "durationSec": 7.368
    },
    {
      "index": 73,
      "text": "鼻孔に残る爽やかさを感じます。",
      "file": "c073.ogg",
      "durationSec": 5.328
    },
    {
      "index": 74,
      "text": "どちらも通常のお部屋に持ち込むことができます。",
      "file": "c074.ogg",
      "durationSec": 6.552
    },
    {
      "index": 75,
      "text": "最後にもう一度、枝の間から空のコインを見上げてください。",
      "file": "c075.ogg",
      "durationSec": 8.688
    },
    {
      "index": 76,
      "text": "十分。",
      "file": "c076.ogg",
      "durationSec": 2.52
    },
    {
      "index": 77,
      "text": "さて、物語は休んで、感覚を保ってください。",
      "file": "c077.ogg",
      "durationSec": 8.256
    },
    {
      "index": 78,
      "text": "この場所の新鮮さを吸い込んでください。",
      "file": "c078.ogg",
      "durationSec": 5.472
    },
    {
      "index": 79,
      "text": "その温かさと静けさの中に息を吐き出します。",
      "file": "c079.ogg",
      "durationSec": 6.84
    },
    {
      "index": 80,
      "text": "吸い込む。",
      "file": "c080.ogg",
      "durationSec": 2.64
    },
    {
      "index": 81,
      "text": "息を吐きます。",
      "file": "c081.ogg",
      "durationSec": 3.288
    },
    {
      "index": 82,
      "text": "また。ソフトに吸い込みます。",
      "file": "c082.ogg",
      "durationSec": 5.832
    },
    {
      "index": 83,
      "text": "息を長く吐く。",
      "file": "c083.ogg",
      "durationSec": 3.408
    },
    {
      "index": 84,
      "text": "この想像の世界の地面に身体が支えられているのを感じてください。",
      "file": "c084.ogg",
      "durationSec": 8.76
    },
    {
      "index": 85,
      "text": "吸い込む。",
      "file": "c085.ogg",
      "durationSec": 2.64
    },
    {
      "index": 86,
      "text": "息を吐きます。",
      "file": "c086.ogg",
      "durationSec": 3.288
    },
    {
      "index": 87,
      "text": "考えがさまよったら、皮膚の温もりに戻りましょう。",
      "file": "c087.ogg",
      "durationSec": 7.272
    },
    {
      "index": 88,
      "text": "あるいは鼻の空気を冷やすためです。",
      "file": "c088.ogg",
      "durationSec": 5.4
    },
    {
      "index": 89,
      "text": "吸い込む。",
      "file": "c089.ogg",
      "durationSec": 2.64
    },
    {
      "index": 90,
      "text": "息を吐きます。",
      "file": "c090.ogg",
      "durationSec": 3.288
    },
    {
      "index": 91,
      "text": "吸い込む。",
      "file": "c091.ogg",
      "durationSec": 2.64
    },
    {
      "index": 92,
      "text": "息を吐きます。",
      "file": "c092.ogg",
      "durationSec": 3.288
    },
    {
      "index": 93,
      "text": "滞在する。柔らかくする。続く。",
      "file": "c093.ogg",
      "durationSec": 7.968
    },
    {
      "index": 94,
      "text": "吸い込む。",
      "file": "c094.ogg",
      "durationSec": 2.64
    },
    {
      "index": 95,
      "text": "息を吐きます。",
      "file": "c095.ogg",
      "durationSec": 3.288
    },
    {
      "index": 96,
      "text": "もう 1 つの簡単なサイクル。",
      "file": "c096.ogg",
      "durationSec": 4.536
    },
    {
      "index": 97,
      "text": "吸い込む。",
      "file": "c097.ogg",
      "durationSec": 2.64
    },
    {
      "index": 98,
      "text": "息を吐きます。",
      "file": "c098.ogg",
      "durationSec": 3.288
    },
    {
      "index": 99,
      "text": "この感覚をもう少し呼吸してください。",
      "file": "c099.ogg",
      "durationSec": 5.496
    },
    {
      "index": 100,
      "text": "暖かさ。柔らかさ。十分です。",
      "file": "c100.ogg",
      "durationSec": 8.304
    },
    {
      "index": 101,
      "text": "必要なときにいつでもこの場所に戻ることができます。",
      "file": "c101.ogg",
      "durationSec": 7.368
    },
    {
      "index": 102,
      "text": "それは想像力の中だけではなく、あなたの注意力の中に生きています。",
      "file": "c102.ogg",
      "durationSec": 9.744
    },
    {
      "index": 103,
      "text": "呼吸を深め始めます。",
      "file": "c103.ogg",
      "durationSec": 4.2
    },
    {
      "index": 104,
      "text": "あなたの周りの部屋をもう一度感じてください。",
      "file": "c104.ogg",
      "durationSec": 6.144
    },
    {
      "index": 105,
      "text": "指を小刻みに動かします。つま先を柔らかくします。",
      "file": "c105.ogg",
      "durationSec": 8.808
    },
    {
      "index": 106,
      "text": "準備ができたら、目を開けてください。",
      "file": "c106.ogg",
      "durationSec": 5.712
    },
    {
      "index": 107,
      "text": "もう一度ゆっくり呼吸してください。",
      "file": "c107.ogg",
      "durationSec": 4.992
    },
    {
      "index": 108,
      "text": "この平穏を次に何が起こっても持ち続けてください。",
      "file": "c108.ogg",
      "durationSec": 6.984
    }
  ]
}
