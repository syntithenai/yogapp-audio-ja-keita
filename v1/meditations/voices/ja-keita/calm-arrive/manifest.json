{
  "id": "calm-arrive",
  "voiceId": "ja-keita",
  "edgeVoice": "ja-JP-KeitaNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 112,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "到着まで少しお時間をください。",
      "file": "c001.ogg",
      "durationSec": 5.136
    },
    {
      "index": 2,
      "text": "快適な座席を見つけるか、気分が良い場合は横になってください。",
      "file": "c002.ogg",
      "durationSec": 8.952
    },
    {
      "index": 3,
      "text": "手を休めましょう。",
      "file": "c003.ogg",
      "durationSec": 3.36
    },
    {
      "index": 4,
      "text": "目を閉じるか、視線を和らげてください。",
      "file": "c004.ogg",
      "durationSec": 6.24
    },
    {
      "index": 5,
      "text": "あなたがここにいることに気づいてください。",
      "file": "c005.ogg",
      "durationSec": 5.424
    },
    {
      "index": 6,
      "text": "今のところ修正することはありません。",
      "file": "c006.ogg",
      "durationSec": 5.424
    },
    {
      "index": 7,
      "text": "完了するものは何もありません。",
      "file": "c007.ogg",
      "durationSec": 4.848
    },
    {
      "index": 8,
      "text": "鼻からゆっくりと息を吸います。",
      "file": "c008.ogg",
      "durationSec": 4.872
    },
    {
      "index": 9,
      "text": "そして息を長く吐く。",
      "file": "c009.ogg",
      "durationSec": 3.96
    },
    {
      "index": 10,
      "text": "また。ソフトに吸い込みます。",
      "file": "c010.ogg",
      "durationSec": 5.832
    },
    {
      "index": 11,
      "text": "ゆっくりと息を吐きます。",
      "file": "c011.ogg",
      "durationSec": 4.104
    },
    {
      "index": 12,
      "text": "体の重みが支えられているのを感じてください。",
      "file": "c012.ogg",
      "durationSec": 6.456
    },
    {
      "index": 13,
      "text": "あなたを支えている床、椅子、地球。",
      "file": "c013.ogg",
      "durationSec": 6.792
    },
    {
      "index": 14,
      "text": "考えがさまよっても、それは問題ありません。",
      "file": "c014.ogg",
      "durationSec": 6.936
    },
    {
      "index": 15,
      "text": "ただ気づいて、この呼吸に戻ってください。",
      "file": "c015.ogg",
      "durationSec": 6.312
    },
    {
      "index": 16,
      "text": "吸い込む。到着。",
      "file": "c016.ogg",
      "durationSec": 5.016
    },
    {
      "index": 17,
      "text": "息を吐きます。解決する。",
      "file": "c017.ogg",
      "durationSec": 6.0
    },
    {
      "index": 18,
      "text": "もう一息。",
      "file": "c018.ogg",
      "durationSec": 2.856
    },
    {
      "index": 19,
      "text": "準備ができたら、目を開けてください。",
      "file": "c019.ogg",
      "durationSec": 5.712
    },
    {
      "index": 20,
      "text": "これを静かに持ち歩きましょう。",
      "file": "c020.ogg",
      "durationSec": 4.656
    }
  ]
}
