{
  "id": "mountain-still-10",
  "voiceId": "ja-keita",
  "edgeVoice": "ja-JP-KeitaNeural",
  "rate": "-42%",
  "pitch": "-12Hz",
  "totalSec": 176,
  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "到着まで時間がかかります。",
      "file": "c001.ogg",
      "durationSec": 4.728
    },
    {
      "index": 2,
      "text": "サポートを受けながら座ったり横になったりしてください。",
      "file": "c002.ogg",
      "durationSec": 6.672
    },
    {
      "index": 3,
      "text": "安全だと感じたら目を閉じてください。",
      "file": "c003.ogg",
      "durationSec": 5.4
    },
    {
      "index": 4,
      "text": "地面との接触を感じます。",
      "file": "c004.ogg",
      "durationSec": 4.776
    },
    {
      "index": 5,
      "text": "ゆっくりと息を吸い込みます。",
      "file": "c005.ogg",
      "durationSec": 4.536
    },
    {
      "index": 6,
      "text": "息を長く吐く。",
      "file": "c006.ogg",
      "durationSec": 3.408
    },
    {
      "index": 7,
      "text": "[休止:28]",
      "file": "c007.ogg",
      "durationSec": 4.2
    },
    {
      "index": 8,
      "text": "また。",
      "file": "c008.ogg",
      "durationSec": 2.16
    },
    {
      "index": 9,
      "text": "[休止:28]",
      "file": "c009.ogg",
      "durationSec": 4.2
    },
    {
      "index": 10,
      "text": "肩を落としましょう。",
      "file": "c010.ogg",
      "durationSec": 3.456
    },
    {
      "index": 11,
      "text": "お腹を柔らかくしましょう。",
      "file": "c011.ogg",
      "durationSec": 4.272
    },
    {
      "index": 12,
      "text": "[休止:36]",
      "file": "c012.ogg",
      "durationSec": 4.296
    },
    {
      "index": 13,
      "text": "自分自身を山だと想像してください。",
      "file": "c013.ogg",
      "durationSec": 5.64
    },
    {
      "index": 14,
      "text": "ベースが広い。静かなピーク。膨大な忍耐力。",
      "file": "c014.ogg",
      "durationSec": 9.984
    },
    {
      "index": 15,
      "text": "[休止:43]",
      "file": "c015.ogg",
      "durationSec": 4.224
    },
    {
      "index": 16,
      "text": "天気は山を越えて移ります。",
      "file": "c016.ogg",
      "durationSec": 4.752
    },
    {
      "index": 17,
      "text": "太陽。風。雲。嵐。",
      "file": "c017.ogg",
      "durationSec": 9.024
    },
    {
      "index": 18,
      "text": "山は残っています。",
      "file": "c018.ogg",
      "durationSec": 3.72
    },
    {
      "index": 19,
      "text": "[休止:57]",
      "file": "c019.ogg",
      "durationSec": 3.888
    },
    {
      "index": 20,
      "text": "思考と気分は天気です。",
      "file": "c020.ogg",
      "durationSec": 4.488
    },
    {
      "index": 21,
      "text": "あなたは山です。",
      "file": "c021.ogg",
      "durationSec": 3.456
    },
    {
      "index": 22,
      "text": "[休止:57]",
      "file": "c022.ogg",
      "durationSec": 3.888
    },
    {
      "index": 23,
      "text": "体の根元がしっかりしているのを感じてください。",
      "file": "c023.ogg",
      "durationSec": 6.456
    },
    {
      "index": 24,
      "text": "負担なく背骨の高さを感じます。",
      "file": "c024.ogg",
      "durationSec": 5.304
    },
    {
      "index": 25,
      "text": "[休止:43]",
      "file": "c025.ogg",
      "durationSec": 4.224
    },
    {
      "index": 26,
      "text": "山の周りの空のように呼吸します。",
      "file": "c026.ogg",
      "durationSec": 5.52
    },
    {
      "index": 27,
      "text": "[休止:71]",
      "file": "c027.ogg",
      "durationSec": 4.416
    },
    {
      "index": 28,
      "text": "安定した。ゆっくりと。十分。",
      "file": "c028.ogg",
      "durationSec": 7.824
    },
    {
      "index": 29,
      "text": "[休止:90]",
      "file": "c029.ogg",
      "durationSec": 3.888
    },
    {
      "index": 30,
      "text": "[休止:43]",
      "file": "c030.ogg",
      "durationSec": 4.224
    },
    {
      "index": 31,
      "text": "呼吸を深め始めます。",
      "file": "c031.ogg",
      "durationSec": 4.2
    },
    {
      "index": 32,
      "text": "もう一度部屋を感じてください。",
      "file": "c032.ogg",
      "durationSec": 4.728
    },
    {
      "index": 33,
      "text": "指や足の指を小刻みに動かします。",
      "file": "c033.ogg",
      "durationSec": 5.616
    },
    {
      "index": 34,
      "text": "準備ができたら、目を開けてください。",
      "file": "c034.ogg",
      "durationSec": 5.712
    },
    {
      "index": 35,
      "text": "ゆっくりと次のことに取り組んでください。",
      "file": "c035.ogg",
      "durationSec": 5.4
    }
  ]
}
