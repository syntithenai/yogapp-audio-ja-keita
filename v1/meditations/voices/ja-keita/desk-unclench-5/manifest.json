  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "座ったままにしてください。仕事の途中用です。",
      "file": "c001.ogg",
      "durationSec": 8.136
    },
    {
      "index": 2,
      "text": "しばらく画面から視線を外してください。",
      "file": "c002.ogg",
      "durationSec": 5.856
    },
    {
      "index": 3,
      "text": "できれば遠くを見てください。",
      "file": "c003.ogg",
      "durationSec": 4.44
    },
    {
      "index": 4,
      "text": "[休止:28]",
      "file": "c004.ogg",
      "durationSec": 4.2
    },
    {
      "index": 5,
      "text": "肩を上、後ろ、下に回します。",
      "file": "c005.ogg",
      "durationSec": 6.264
    },
    {
      "index": 6,
      "text": "あと2回。",
      "file": "c006.ogg",
      "durationSec": 2.688
    },
    {
      "index": 7,
      "text": "[休止:38]",
      "file": "c007.ogg",
      "durationSec": 4.464
    },
    {
      "index": 8,
      "text": "手を開いたり閉じたりします。",
      "file": "c008.ogg",
      "durationSec": 4.464
    },
    {
      "index": 9,
      "text": "軽く振ってください。",
      "file": "c009.ogg",
      "durationSec": 3.552
    },
    {
      "index": 10,
      "text": "[休止:28]",
      "file": "c010.ogg",
      "durationSec": 4.2
    },
    {
      "index": 11,
      "text": "眉を柔らかくします。",
      "file": "c011.ogg",
      "durationSec": 4.008
    },
    {
      "index": 12,
      "text": "顎を緩めます。舌を休ませましょう。",
      "file": "c012.ogg",
      "durationSec": 7.104
    },
    {
      "index": 13,
      "text": "[休止:38]",
      "file": "c013.ogg",
      "durationSec": 4.464
    },
    {
      "index": 14,
      "text": "肋骨の側面に息を吸います。",
      "file": "c014.ogg",
      "durationSec": 5.088
    },
    {
      "index": 15,
      "text": "息を吐き、胸を落ち着かせます。",
      "file": "c015.ogg",
      "durationSec": 5.616
    },
    {
      "index": 16,
      "text": "[休止:38]",
      "file": "c016.ogg",
      "durationSec": 4.464
    },
    {
      "index": 17,
      "text": "ゆっくりと3回点滅します。",
      "file": "c017.ogg",
      "durationSec": 4.848
    },
    {
      "index": 18,
      "text": "[休止:28]",
      "file": "c018.ogg",
      "durationSec": 4.2
    },
    {
      "index": 19,
      "text": "もう一息。",
      "file": "c019.ogg",
      "durationSec": 2.856
    },
    {
      "index": 20,
      "text": "準備ができたら、少し緊張を緩めて戻ってください。",
      "file": "c020.ogg",
      "durationSec": 7.8
    },
    {
      "index": 21,
      "text": "[休止:28]",
      "file": "c021.ogg",
      "durationSec": 4.2
    },
    {
      "index": 22,
      "text": "もう一度ゆっくり呼吸してください。",
      "file": "c022.ogg",
      "durationSec": 4.992
    },
    {
      "index": 23,
      "text": "指を小刻みに動かします。",
      "file": "c023.ogg",
      "durationSec": 4.56
    },
    {
      "index": 24,
      "text": "準備ができたら、目を開けてください。",
      "file": "c024.ogg",
      "durationSec": 5.712
    },
    {
      "index": 25,
      "text": "安心して次のタスクに戻れます。",
