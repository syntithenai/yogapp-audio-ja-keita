  "totalSec": 140,
  "chunks": [
    {
      "index": 0,
      "text": "安定した姿勢に落ち着きます。",
      "file": "c000.ogg",
      "durationSec": 4.8
    },
    {
      "index": 1,
      "text": "背骨は高いが、堅くない。",
      "file": "c001.ogg",
      "durationSec": 4.848
    },
    {
      "index": 2,
      "text": "ありのままの呼吸に注意を向けてください。",
      "file": "c002.ogg",
      "durationSec": 5.784
    },
    {
      "index": 3,
      "text": "まだ変更しないでください。ただ見てください。",
      "file": "c003.ogg",
      "durationSec": 7.464
    },
    {
      "index": 4,
      "text": "鼻孔から吸い込むと涼しさを感じます。",
      "file": "c004.ogg",
      "durationSec": 5.784
    },
    {
      "index": 5,
      "text": "吐く息の温かさを感じてください。",
      "file": "c005.ogg",
      "durationSec": 5.28
    },
    {
      "index": 6,
      "text": "または、お腹の膨らみやへこみに注目してください。",
      "file": "c006.ogg",
      "durationSec": 7.416
    },
    {
      "index": 7,
      "text": "注意を休める場所を 1 つ選択してください。",
      "file": "c007.ogg",
      "durationSec": 6.096
    },
    {
      "index": 8,
      "text": "心がさまよったら、親切に戻​​ってきてください。",
      "file": "c008.ogg",
      "durationSec": 7.08
    },
    {
      "index": 9,
      "text": "判断はありません。ただ戻ってください。",
      "file": "c009.ogg",
      "durationSec": 7.008
    },
    {
      "index": 10,
      "text": "さて、それが簡単だと感じたら、ソフトサイクルを数えてください。",
      "file": "c010.ogg",
      "durationSec": 9.672
    },
    {
      "index": 11,
      "text": "吸い込む。 1つ。",
      "file": "c011.ogg",
      "durationSec": 4.872
    },
    {
      "index": 12,
      "text": "息を吐きます。 1つ。",
      "file": "c012.ogg",
      "durationSec": 5.52
    },
    {
      "index": 13,
      "text": "吸い込む。二。",
      "file": "c013.ogg",
      "durationSec": 4.416
    },
    {
      "index": 14,
      "text": "息を吐きます。二。",
      "file": "c014.ogg",
      "durationSec": 5.064
    },
    {
      "index": 15,
      "text": "5 つまで続けてから、再び 1 つから始めます。",
      "file": "c015.ogg",
      "durationSec": 7.416
    },
    {
      "index": 16,
      "text": "カウントを失った場合は、優しさからやり直してください。",
      "file": "c016.ogg",
      "durationSec": 7.848
    },
    {
      "index": 17,
      "text": "戻ることは練習です。",
      "file": "c017.ogg",
      "durationSec": 4.176
    },
    {
      "index": 18,
      "text": "呼吸を自然にしましょう。負担はありません。",
      "file": "c018.ogg",
      "durationSec": 7.44
    },
    {
      "index": 19,
      "text": "沈黙の中でさらに数サイクル。",
      "file": "c019.ogg",
      "durationSec": 5.04
    },
    {
      "index": 20,
      "text": "カウントを解除します。",
      "file": "c020.ogg",
      "durationSec": 3.96
    },
    {
      "index": 21,
      "text": "しばらくの間、開いた意識の中で休んでください。",
      "file": "c021.ogg",
      "durationSec": 7.608
    },
    {
      "index": 22,
      "text": "準備ができたら、目を開けてください。",
      "file": "c022.ogg",
      "durationSec": 5.712
    }
  ]
}
