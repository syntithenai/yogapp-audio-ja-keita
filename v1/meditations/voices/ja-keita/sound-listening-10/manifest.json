  "chunks": [
    {
      "index": 0,
      "text": "いらっしゃいませ。",
      "file": "c000.ogg",
      "durationSec": 3.096
    },
    {
      "index": 1,
      "text": "到着まで時間がかかります。",
      "file": "c001.ogg",
      "durationSec": 4.728
    },
    {
      "index": 2,
      "text": "サポートを受けながら座ったり横になったりしてください。",
      "file": "c002.ogg",
      "durationSec": 6.672
    },
    {
      "index": 3,
      "text": "安全だと感じたら目を閉じてください。",
      "file": "c003.ogg",
      "durationSec": 5.4
    },
    {
      "index": 4,
      "text": "地面との接触を感じます。",
      "file": "c004.ogg",
      "durationSec": 4.776
    },
    {
      "index": 5,
      "text": "ゆっくりと息を吸い込みます。",
      "file": "c005.ogg",
      "durationSec": 4.536
    },
    {
      "index": 6,
      "text": "息を長く吐く。",
      "file": "c006.ogg",
      "durationSec": 3.408
    },
    {
      "index": 7,
      "text": "[休止:23]",
      "file": "c007.ogg",
      "durationSec": 4.176
    },
    {
      "index": 8,
      "text": "また。",
      "file": "c008.ogg",
      "durationSec": 2.16
    },
    {
      "index": 9,
      "text": "[休止:23]",
      "file": "c009.ogg",
      "durationSec": 4.176
    },
    {
      "index": 10,
      "text": "肩を落としましょう。",
      "file": "c010.ogg",
      "durationSec": 3.456
    },
    {
      "index": 11,
      "text": "お腹を柔らかくしましょう。",
      "file": "c011.ogg",
      "durationSec": 4.272
    },
    {
      "index": 12,
      "text": "[休止:29]",
      "file": "c012.ogg",
      "durationSec": 4.056
    },
    {
      "index": 13,
      "text": "耳を開けてください。",
      "file": "c013.ogg",
      "durationSec": 3.672
    },
    {
      "index": 14,
      "text": "最も近い音に注目してください。",
      "file": "c014.ogg",
      "durationSec": 5.424
    },
    {
      "index": 15,
      "text": "[休止:29]",
      "file": "c015.ogg",
      "durationSec": 4.056
    },
    {
      "index": 16,
      "text": "聞こえる最も遠い音に注目してください。",
      "file": "c016.ogg",
      "durationSec": 6.168
    },
    {
      "index": 17,
      "text": "[休止:29]",
      "file": "c017.ogg",
      "durationSec": 4.056
    },
    {
      "index": 18,
      "text": "音の間の沈黙に注目してください。",
      "file": "c018.ogg",
      "durationSec": 5.736
    },
    {
      "index": 19,
      "text": "[休止:35]",
      "file": "c019.ogg",
      "durationSec": 4.104
    },
    {
      "index": 20,
      "text": "音は発生し、通過します。名前を付ける必要はありません。",
      "file": "c020.ogg",
      "durationSec": 10.392
    },
    {
      "index": 21,
      "text": "聴覚は聞こえます。",
      "file": "c021.ogg",
      "durationSec": 3.744
    },
    {
      "index": 22,
      "text": "[休止:47]",
      "file": "c022.ogg",
      "durationSec": 4.104
    },
    {
      "index": 23,
      "text": "心がさまよったら、聞くことに戻りましょう。",
      "file": "c023.ogg",
      "durationSec": 6.456
    },
    {
      "index": 24,
      "text": "[休止:35]",
      "file": "c024.ogg",
      "durationSec": 4.104
    },
    {
      "index": 25,
      "text": "自分の呼吸の音も含めてください。",
      "file": "c025.ogg",
      "durationSec": 5.304
    },
    {
      "index": 26,
      "text": "[休止:35]",
      "file": "c026.ogg",
      "durationSec": 4.104
    },
    {
      "index": 27,
      "text": "サウンドスケープ全体の中で休んでください。",
      "file": "c027.ogg",
      "durationSec": 6.24
    },
    {
      "index": 28,
      "text": "生きた振動場。",
      "file": "c028.ogg",
      "durationSec": 3.576
    },
    {
      "index": 29,
      "text": "[休止:90]",
      "file": "c029.ogg",
      "durationSec": 3.888
    },
    {
      "index": 30,
      "text": "聞いても何も解決しない。",
      "file": "c030.ogg",
      "durationSec": 4.392
    },
    {
      "index": 31,
      "text": "[休止:70]",
      "file": "c031.ogg",
      "durationSec": 3.96
    },
    {
      "index": 32,
      "text": "[休止:35]",
      "file": "c032.ogg",
      "durationSec": 4.104
    },
    {
      "index": 33,
      "text": "呼吸を深め始めます。",
      "file": "c033.ogg",
      "durationSec": 4.2
    },
    {
      "index": 34,
      "text": "ここで休んでください。",
      "file": "c034.ogg",
      "durationSec": 3.792
    },
    {
      "index": 35,
      "text": "[休止:27]",
      "file": "c035.ogg",
      "durationSec": 4.056
    },
    {
      "index": 36,
      "text": "もう一度部屋を感じてください。",
      "file": "c036.ogg",
      "durationSec": 4.728
    },
    {
      "index": 37,
      "text": "指や足の指を小刻みに動かします。",
      "file": "c037.ogg",
      "durationSec": 5.616
    },
    {
      "index": 38,
      "text": "準備ができたら、目を開けてください。",
      "file": "c038.ogg",
      "durationSec": 5.712
    },
    {
      "index": 39,
      "text": "ゆっくりと次のことに取り組んでください。",
